# Local Finance Agent environment
# All values optional — the agent runs fully offline by default.

# Path to the local ledger database (SQLite)
LFA_DB_PATH=./data/db/ledger.db

# Ollama endpoint for the AI query layer (Milestone 0.2)
# Leave empty to run without any LLM.
OLLAMA_BASE_URL=http://localhost:11434

# Default model for Q&A (only used when OLLAMA_BASE_URL is set)
LFA_OLLAMA_MODEL=qwen3:8b

# Never set real API keys here — this file is a template only.
